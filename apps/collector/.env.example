# 와글 수집기 환경변수
# 로컬: 이 파일을 같은 폴더에 .env.local 이름으로 복사해 값을 채운다 (.env.local은 커밋되지 않는다)
# Railway: 서비스 → Variables 탭에 같은 이름으로 넣는다 (README.md 참고)

# ── 필수 ─────────────────────────────────────────

# Supabase DB 연결 주소. Supabase 프로젝트 화면 위쪽 [Connect] → "Session pooler"의 URI를 복사하고 [YOUR-PASSWORD]를 DB 비밀번호로 바꾼다
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

# 치지직 Client ID. 치지직 개발자센터(https://developers.chzzk.naver.com) → 애플리케이션 등록 후 애플리케이션 정보에서 확인
CHZZK_CLIENT_ID=

# 치지직 Client Secret. 위와 같은 화면에서 확인 (다른 사람에게 보여주지 말 것)
CHZZK_CLIENT_SECRET=

# ── 선택 ─────────────────────────────────────────

# 수집 실패 알림용 디스코드 웹후크 URL. 디스코드 채널 설정(톱니) → 연동 → 웹후크 → 새 웹후크 → 웹후크 URL 복사. 비우면 알림 없이 로그만 남긴다
DISCORD_WEBHOOK_URL=

# 수집 주기(초). 기본 60. 30 이상. 호출 한도 오류(429)가 잦으면 늘린다
POLL_INTERVAL_SEC=60

# 치지직 라이브 목록 페이지 사이 대기(ms). 기본 50. 호출 한도 오류(429)가 잦으면 늘린다
CHZZK_PAGE_DELAY_MS=50

# 이 시청자 수 미만 방송은 저장하지 않는다. 기본 0(전부 저장). DB 용량이 부족할 때만 올린다 (README "DB 용량" 참고)
MIN_VIEWERS=0

# 연속 몇 번 실패하면 디스코드로 알릴지. 기본 3
ALERT_AFTER_FAILURES=3

# 며칠 지난 스냅샷을 10분 간격으로 줄일지. 기본 30 (docs/spec.md)
SNAPSHOT_DOWNSAMPLE_AFTER_DAYS=30
